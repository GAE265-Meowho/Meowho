# 複製成 .env.local 後填值（.env.local 不會被 commit）：cp .env.example .env.local
# 只要填「← 填」標示的兩把金鑰（向子哲私訊索取），其他已填好；改完要重新啟動 npm run dev。
# 規則：值後面不要加註解或空白；金鑰不要貼進群組、GitHub、程式碼或 AI 對話。設定細節見 docs/setup/SUPABASE_LLM_SETUP.md

# Supabase：資料庫與登入（未填金鑰時網站以「示範模式」運作：可操作但不能登入與儲存）
# 登入前請確認你的 Gmail 已加入 Google 登入的測試使用者名單；本機一律用 http://localhost:3000 開啟
NEXT_PUBLIC_SUPABASE_URL=https://onebpkbkrnnwamwsoelo.supabase.co
# ← 填：Supabase 的 anon（Publishable）key；不要填 service_role
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Azure Blob：貓影片、居家影像、3D 檔（決策 006；未填金鑰時影片上傳關閉）
# 本機與 PR 預覽一律用 media-dev；media 只給正式站，不要改
MEDIA_STORAGE=azure
AZURE_STORAGE_ACCOUNT=meowhomedia
# ← 填：Azure 儲存帳戶 meowhomedia 的 key1
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=media-dev

# AI（LangChain）：AI_PROVIDER = gemini｜openai｜azure｜anthropic（未設定金鑰時改用規則式解析）
# 選填：要測 AI 功能時到 https://aistudio.google.com/apikey 申請自己的 Gemini 金鑰
# 換模型只改這裡，程式不用動。舊的 LLM_PROVIDER／LLM_MODEL 仍相容。
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# 文字任務模型（不填用預設）
# AI_MODEL=gemini-3.1-flash-lite
# 影像任務模型（不填同 AI_MODEL）
# AI_MODEL_VISION=gemini-3.1-flash-lite

# 1 = 使用 public/photos 本機照片（先執行 npm run photos:download）
NEXT_PUBLIC_LOCAL_PHOTOS=0
