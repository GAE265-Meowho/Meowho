# 複製成 .env.local 後填值（.env.local 不會被 commit）。設定步驟見 docs/setup/SUPABASE_LLM_SETUP.md

# Supabase（未設定時網站以「示範模式」運作：可操作但不能登入與儲存）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI（LangChain）：AI_PROVIDER = gemini｜openai｜azure｜anthropic（未設定金鑰時改用規則式解析）
# 換模型只改這裡，程式不用動。舊的 LLM_PROVIDER／LLM_MODEL 仍相容。
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AI_MODEL=gemini-2.5-flash          # 文字任務模型（不填用預設）
# AI_MODEL_VISION=gemini-2.5-flash   # 影像任務模型（不填同 AI_MODEL）

# 大型檔案（貓影片、居家影像、3D 檔）儲存（決策 006）；未設定時影片上傳關閉
# MEDIA_STORAGE=azure
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=

# 1 = 使用 public/photos 本機照片（先執行 npm run photos:download）
NEXT_PUBLIC_LOCAL_PHOTOS=0
