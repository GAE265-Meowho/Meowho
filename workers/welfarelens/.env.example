ENABLE_CLOUD_ANALYSIS=false
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Video jobs: global one-time acceptance lock is no longer used.
# Extra transport retries (0..2), in addition to the initial attempt.
WELFARELENS_VIDEO_MAX_RETRIES=2
# Concurrent active video jobs (1..8); completed history does not consume slots.
WELFARELENS_VIDEO_MAX_JOBS=2
# Independent frame/detail workers per job (1 or 2).
WELFARELENS_VIDEO_CONCURRENCY=2

# Image editing (POST /api/improve; separate explicit photo consent)
# Endpoint: Azure resource root URL; key stays server-side.
ENABLE_IMAGE_EDITING=false
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_DEPLOYMENT=

# Optional server-to-server bridge (disabled when unset; never NEXT_PUBLIC)
# Use a server-managed random secret with at least 32 characters; do not expose to the browser.
WELFARELENS_INTEGRATION_KEY=

# Docker Worker uses --env-file explicitly. Never commit the actual file.
MEOWHO_SUPABASE_URL=
MEOWHO_SUPABASE_SERVICE_ROLE_KEY=
MEOWHO_BLOB_CONTAINER=media-dev
# Leave empty only when the VM has verified Managed Identity access.
WELFARELENS_MEDIA_DEV_SAS_URL=
MEOWHO_WORKER_TMP=/data
WELFARELENS_PDF_BROWSER=/usr/bin/chromium
WELFARELENS_PRIVATE_HTML=false
WELFARELENS_PRIVATE_REPORT_VIEW=false
WELFARELENS_IMAGE_EDIT_CONCURRENCY=1
MEOWHO_QUEUE_ENABLED=false
MEOWHO_WORKER_SERVICE=false
# Leave empty on the shared team project. Required for an exclusive queue.
# MEOWHO_DEDICATED_QUEUE_PROJECT_REF=
# Optional for a bounded --poll run. Limits attempts, not job IDs.
# MEOWHO_WORKER_MAX_JOBS=1
MEOWHO_WORKER_POLL_MS=10000
