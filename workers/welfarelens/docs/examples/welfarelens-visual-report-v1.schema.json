    "match_evidence": {
      "maxItems": 4000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "observation_ids": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
