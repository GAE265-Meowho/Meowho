                          "minLength": 1,
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "OBSERVATION",
                        "INFERENCE",
                        "CONFIRMATION",
                        "UNKNOWN",
                        "HYPOTHESIS"
                      ]
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    "previous": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        },
                        "value": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "OBSERVATION",
                            "INFERENCE",
                            "CONFIRMATION",
                            "UNKNOWN",
                            "HYPOTHESIS"
                          ]
                        },
                        "evidence": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high"
                          ]
                        }
                      },
                      "required": [
                        "key",
                        "value",
                        "status",
                        "evidence",
                        "confidence"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "key",
                    "value",
                    "status",
                    "evidence",
                    "confidence"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "plant": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "object_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 19
                  },
                  "candidates": {
                    "maxItems": 3,
                    "type": "array",
