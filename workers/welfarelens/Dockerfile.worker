# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS dependencies
WORKDIR /build
COPY package.json package-lock.json ./
# The headless entrypoints do not use the Next.js UI runtime.
RUN --mount=type=cache,target=/root/.npm \
    npm pkg delete dependencies.next dependencies.react dependencies.react-dom \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:24-bookworm-slim AS worker
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg chromium fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/node_modules /data && chown node:node /data
WORKDIR /app
COPY --from=dependencies /build/node_modules ./node_modules
COPY package.json ./
COPY src/domain ./src/domain
COPY src/data ./src/data
COPY src/server ./src/server
COPY scripts/standalone-worker.ts ./scripts/standalone-worker.ts
COPY scripts/meowho-worker.ts ./scripts/meowho-worker.ts
COPY scripts/meowho-blob-smoke.ts ./scripts/meowho-blob-smoke.ts
COPY evals/fixtures/worker-scene.json ./evals/fixtures/worker-scene.json
ENV NODE_ENV=production ENABLE_CLOUD_ANALYSIS=false WELFARELENS_PDF_BROWSER=/usr/bin/chromium WELFARELENS_PDF_NO_SANDBOX=true HOME=/tmp
USER node
HEALTHCHECK --interval=30s --timeout=10s --retries=2 CMD ["node", "--experimental-strip-types", "scripts/standalone-worker.ts", "--self-test"]
ENTRYPOINT ["node", "--experimental-strip-types", "scripts/standalone-worker.ts"]
CMD ["--self-test"]
