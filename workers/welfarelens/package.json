{
  "name": "welfarelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build && node scripts/check-private-trace.mjs --prune && node scripts/check-private-trace.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "eval:report": "node --experimental-strip-types scripts/eval-report.ts",
    "eval:run": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/eval-run.ts",
    "test:e2e": "playwright test",
    "worker:fixture": "node --experimental-strip-types scripts/standalone-worker.ts",
    "worker:test-fixture": "node --experimental-strip-types scripts/create-test-video.ts",
    "worker:health": "node --experimental-strip-types scripts/standalone-worker.ts --self-test"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
